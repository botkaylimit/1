-- Vòng lặp Auto Scan & Server Hop
task.spawn(function()
    RefreshScan()
    while task.wait(4) do
        if Config.AutoScanHop then
            RefreshScan()
            local best = DiscoveredServers[1]
            local targetVal = MinValues[Config.MinValueIndex].Val
            if not best or best.Value < targetVal then
                HopNextServer()
            else
                StatusLabel.Text = "Target found in server! Stopping hop."
            end
        end
    end
end)

            MutLabel.Position = UDim2.new(0, 0, 1, -14)
            MutLabel.Size = UDim2.new(1, 0, 0, 14)
            MutLabel.Font = Enum.Font.FredokaOne
            MutLabel.Text = item.Mutation ~= "" and item.Mutation or "Normal"
            MutLabel.TextColor3 = item.Mutation == "Rainbow" and Color3.fromRGB(255, 120, 255)
                or (item.Mutation == "Golden" and Color3.fromRGB(255, 215, 50) or Color3.fromRGB(200, 200, 200))

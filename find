            local rStroke = Instance.new("UIStroke", Row)
            rStroke.Color = Color3.fromRGB(25, 25, 30)
            rStroke.Thickness = 1.5

            -- Khung Avatar Pet
            local IconBox = Instance.new("Frame", Row)
            IconBox.BackgroundColor3 = Color3.fromRGB(48, 50, 56)

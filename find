            local timeStr = diffSec < 60 and (diffSec .. "s ago") or (math.floor(diffSec / 60) .. "m ago")
            InfoLbl.Text = string.format(
                '<font color="#55FF55">%s</font>  <font color="#FFCC33">x%.2f</font>  <font color="#CCCCCC">%s</font>',
                FormatCurrency(item.Value), item.Multiplier, timeStr
            )
            InfoLbl.TextSize = 12
            InfoLbl.TextXAlignment = Enum.TextXAlignment.Left

            -- Nút Join / Teleport

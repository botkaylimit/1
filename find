    local minAllowed = MinValues[Config.MinValueIndex].Val
    local reqRarity = Rarities[Config.RarityIndex]

    for idx, item in ipairs(DiscoveredServers) do
        local passValue = item.Value >= minAllowed
        local passRarity = (reqRarity == "Any") or (item.Mutation:lower() == reqRarity:lower())

        if passValue and passRarity then
            local Row = Instance.new("Frame", ListScroll)
            Row.BackgroundColor3 = Color3.fromRGB(62, 64, 72)
            Row.Size = UDim2.new(1, -4, 0, 54)
            Row.LayoutOrder = idx

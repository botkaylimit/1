-- Hàm chuyển đổi chuỗi tiền tệ (VD: "$29.22B/s" -> 29220000000)
local function ParseCurrency(str)
    if type(str) == "number" then return str end
    if type(str) ~= "string" then return 0 end
    local clean = str:upper():gsub("[,%$%s/S]", "")
    local num, suffix = clean:match("([%d%.]+)([KMBTQaQi]*)")
    num = tonumber(num)
    if not num then return 0 end
    local mult = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18
    }
    return num * (mult[suffix] or 1)
end

-- Hàm định dạng số thành chuỗi hiển thị
local function FormatCurrency(val)
    if val >= 1e12 then return string.format("$%.2fT/s", val / 1e12)
    elseif val >= 1e9 then return string.format("$%.2fB/s", val / 1e9)
    elseif val >= 1e6 then return string.format("$%.2fM/s", val / 1e6)
    elseif val >= 1e3 then return string.format("$%.2fK/s", val / 1e3)
    else return string.format("$%d/s", val) end
end

-- Quét toàn bộ Workspace tìm Pet / Egg có giá trị $/s cao nhất trong Server
local function ScanCurrentServer()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder") then
            -- Kiểm tra Attributes hoặc ValueObjects hoặc BillboardGui
            local valPerSec = obj:GetAttribute("Value") or obj:GetAttribute("Income") or obj:GetAttribute("MoneyPerSecond") or obj:GetAttribute("CashPerSec")
            local petName = obj:GetAttribute("PetName") or obj:GetAttribute("EggName") or obj.Name
            local mutation = obj:GetAttribute("Mutation") or obj:GetAttribute("Rarity") or ""
            local sizeMult = obj:GetAttribute("Size") or obj:GetAttribute("Multiplier") or 1

            -- Nếu game hiển thị qua BillboardGui trên đầu Pet/Egg
            if not valPerSec then
                local gui = obj:FindFirstChildWhichIsA("BillboardGui", true)
                if gui then
                    for _, lbl in ipairs(gui:GetDescendants()) do
                        if lbl:IsA("TextLabel") then
                            local txt = lbl.Text
                            if txt:find("/s") or txt:find("%$") then
                                local parsed = ParseCurrency(txt)
                                if parsed > (valPerSec or 0) then
                                    valPerSec = parsed
                                end
                            elseif txt:find("^x[%d%.]+") then
                                sizeMult = tonumber(txt:match("x([%d%.]+)")) or sizeMult
                            elseif txt == "Golden" or txt == "Rainbow" or txt == "Divine" or txt == "Eternal" then
                                mutation = txt
                            elseif #txt > 2 and not txt:find("%d") then
                                petName = txt
                            end
                        end
                    end
                end
            else
                valPerSec = ParseCurrency(valPerSec)
            end

            if valPerSec and valPerSec > 0 then
                table.insert(results, {
                    Name = tostring(petName),
                    Value = valPerSec,
                    Mutation = tostring(mutation),
                    Multiplier = tonumber(sizeMult) or 1,
                    JobId = CurrentJobId,
                    Timestamp = os.time(),
                    Instance = obj
                })
            end
        end
    end

    table.sort(results, function(a, b) return a.Value > b.Value end)
    return results
end

